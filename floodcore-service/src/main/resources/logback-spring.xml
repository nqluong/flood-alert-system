<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Import Spring Boot defaults (console output, log levels from application.yml) -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- Dedicated appender: only GeoJSON responses from ORS -->
    <appender name="GEOJSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/geojson-debug.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} --- %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/geojson-debug.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>50MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <logger name="geojson.ors.response" level="INFO" additivity="false">
        <appender-ref ref="GEOJSON_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
